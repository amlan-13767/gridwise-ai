# Copy to .env (never commit real values)
DATABASE_URL=sqlite:///./gridwise.db            # or postgresql://user:pass@host:5432/gridwise
SECRET_KEY=change-me-long-random-string          # also derives per-device MQTT/HTTP keys
JWT_SECRET_KEY=                                  # unused: SECRET_KEY signs JWTs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000        # frontend (public, contains no secrets)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=gridwise
MQTT_PASSWORD=
REDIS_URL=redis://localhost:6379/0
WEATHER_API_KEY=                                 # not used: weather is simulated
OPENAI_API_KEY=                                  # not used: no LLM feature implemented
GRID_EMISSIONS_FACTOR=0.82                       # kgCO2e/kWh ASSUMPTION - replace with an official value
ELECTRICITY_TARIFF=6.0                           # INR/kWh ASSUMPTION
DEMO_PASSWORD=                                   # quote values containing # ; password for seeded demo accounts (simulated env only)
